{
  "name": "get-word-game-answers",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development PORT=8081 node --watch src/index.js",
    "deploy": "gcloud builds submit --tag us-west1-docker.pkg.dev/tryhard-word-games/apps/get-word-game-answers && gcloud run deploy get-word-game-answers --image us-west1-docker.pkg.dev/tryhard-word-games/apps/get-word-game-answers --region us-west1 --memory 2Gi --cpu 1 --timeout 300 --no-allow-unauthenticated --set-env-vars NODE_ENV=production --concurrency 1",
    "logs": "gcloud run services logs read get-word-game-answers --region us-west1 --limit 50",
    "answers": "node src/cli.mjs",
    "answers:post": "node src/cli.mjs --post",
    "answers:colordle": "node src/cli.mjs colordle",
    "answers:connections": "node src/cli.mjs connections",
    "answers:contexto": "node src/cli.mjs contexto",
    "answers:harmonies": "node src/cli.mjs harmonies",
    "answers:jumble": "node src/cli.mjs jumble",
    "answers:keyword": "node src/cli.mjs keyword",
    "answers:letroso": "node src/cli.mjs letroso --amount 2",
    "answers:marveldle": "node src/cli.mjs marveldle",
    "answers:nerdle": "node src/cli.mjs nerdle",
    "answers:nyt-bonus": "node src/cli.mjs nyt-bonus",
    "answers:on_the_record": "node src/cli.mjs on_the_record",
    "answers:parseword": "node src/cli.mjs parseword",
    "answers:phrazle": "node src/cli.mjs phrazle",
    "answers:pimantle": "node src/cli.mjs pimantle",
    "answers:poeltl": "node src/cli.mjs poeltl",
    "answers:quordle": "node src/cli.mjs quordle",
    "answers:revealed": "node src/cli.mjs revealed",
    "answers:searchle": "node src/cli.mjs searchle",
    "answers:semantle-junior": "node src/cli.mjs semantle-junior",
    "answers:shuffalo": "node src/cli.mjs shuffalo",
    "answers:squareword": "node src/cli.mjs squareword",
    "answers:strands": "node src/cli.mjs strands",
    "answers:weaver": "node src/cli.mjs weaver",
    "answers:weaver-x": "node src/cli.mjs weaver-x",
    "answers:wordle": "node src/cli.mjs wordle"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@sparticuz/chromium": "^143.0.4",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "color-name-list": "^14.27.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.6",
    "jsdom": "^27.1.0",
    "json5": "^2.2.3",
    "moment": "^2.29.5",
    "node-fetch": "^3.3.2",
    "puppeteer": "^24.18.0",
    "puppeteer-core": "^24.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "wpapi": "^1.2.2",
    "xvfb": "^0.4.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
