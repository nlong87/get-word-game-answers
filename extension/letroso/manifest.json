{
    "manifest_version": 3,
    "name": "Tryhard Letroso Capture",
    "description": "Captures the daily Letroso answer and hands it to get-word-game-answers to post.",
    "version": "1.0.0",
    "key": "",
    "minimum_chrome_version": "111",
    "permissions": ["alarms", "storage", "nativeMessaging"],
    "host_permissions": ["https://letroso.com/*"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Capture today's Letroso answer"
    },
    "content_scripts": [
        {
            "matches": ["https://letroso.com/*"],
            "js": ["tap.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://letroso.com/*"],
            "js": ["relay.js"],
            "run_at": "document_start"
        }
    ]
}
